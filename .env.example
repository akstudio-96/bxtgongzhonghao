# ============================================
# 冰箱贴公众号自动化工具 · 配置文件
# 冰箱贴大王：回家使用前只需要填下面几行即可
# ============================================

# --- 微信公众号凭证（必填）---
# 登录 mp.weixin.qq.com → 设置与开发 → 基本配置 中获取
WECHAT_APPID=wxf3dfd29c06f302ce
WECHAT_APPSECRET=请替换为您的真实AppSecret

# --- 通知推送（必填，用Server酱推送审稿通知到您微信）---
# 去 https://sct.ftqq.com 注册拿 SendKey，复制到下面
SERVERCHAN_SENDKEY=请替换为您的Server酱SendKey

# --- LLM 大模型（必填，生成文章正文用）---
# 推荐使用：OpenAI / 智谱AI / 月之暗面 / DeepSeek 等任一兼容OpenAI格式的厂商
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=请替换为您的LLM API Key
LLM_MODEL=deepseek-chat

# --- 图库搜索（可选，不配也能用，会用占位图）---
# Unsplash：https://unsplash.com/developers 免费拿 Access Key
UNSPLASH_ACCESS_KEY=
# Pexels：https://www.pexels.com/api/ 免费拿（兜底用）
PEXELS_API_KEY=

# --- 服务端端口（一般不用改）---
PORT=3000

# --- 本机出口 IP（可选，填了会显示在初始化页方便您加白名单）---
# 如果不填，系统启动时会自动获取
LOCAL_EXIT_IP=
